{
  "name": "kcc-workbench",
  "version": "1.0.0-beta.2",
  "description": "Unofficial local desktop workbench for Kimi Code with quota forecasting, visual configuration, artifact diffs, file previews, and task time travel",
  "main": "src/main/main.js",
  "type": "module",
  "author": "Dylan5237",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "test": "node --test",
    "bundle:elk": "node scripts/bundle-layout-elk.mjs",
    "build": "electron-builder --win --dir",
    "dist": "electron-builder --win",
    "pack": "node scripts/pack.mjs"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0"
  },
  "build": {
    "appId": "com.local.kccworkbench",
    "productName": "KCC Workbench",
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": [
      "node_modules/@cloudcli-ai/**",
      "node_modules/better-sqlite3/**",
      "node_modules/elkjs/**",
      "node_modules/@mermaid-js/**"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "README.md"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "KCC-Workbench-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@cloudcli-ai/cloudcli": "^1.37.0",
    "@mermaid-js/layout-elk": "^0.2.2",
    "better-sqlite3": "^12.6.2",
    "dompurify": "^3.4.12",
    "marked": "^12.0.2",
    "mermaid": "^11.16.0"
  }
}
